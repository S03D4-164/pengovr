FROM python:3.11-slim

# Install system dependencies including Xvfb and browser requirements
RUN apt-get update && apt-get install -y \
    curl \
    xvfb \
    x11-utils \
    libx11-6 \
    libxext6 \
    libxrender1 \
    fonts-liberation \
    libasound2 \
    libatk-bridge2.0-0 \
    libatk1.0-0 \
    libcups2 \
    libdbus-1-3 \
    libdrm2 \
    libgbm1 \
    libglib2.0-0 \
    libgtk-3-0 \
    libnspr4 \
    libnss3 \
    libpango-1.0-0 \
    libpangocairo-1.0-0 \
    libpulse0 \
    libx11-xcb1 \
    libxcb1 \
    libxcomposite1 \
    libxcursor1 \
    libxdamage1 \
    libxfixes3 \
    libxi6 \
    libxinerama1 \
    libxrandr2 \
    libxss1 \
    libxtst6 \
    ca-certificates \
    git \
    && rm -rf /var/lib/apt/lists/*

# Install pip and uv
RUN pip install --no-cache-dir --upgrade pip uv

WORKDIR /app/worker

# Copy project files
COPY pyproject.toml uv.lock* ./
COPY . .

# Install dependencies using uv
RUN uv sync --no-dev

# Create startup script with Xvfb
RUN cat > /app/worker/entrypoint.sh << 'EOF'
#!/bin/bash
set -e

export DISPLAY=:99
export PATH="/app/worker/.venv/bin:$PATH"

echo "Starting Xvfb on DISPLAY=$DISPLAY..."
rm -f /tmp/.X99-lock 2>/dev/null || true
Xvfb :99 -screen 0 1920x1080x24 >/dev/null 2>&1 &
XVFB_PID=$!
sleep 2

echo "Xvfb started with PID $XVFB_PID"

# Run the Python worker
exec uv run src/main.py

EOF

RUN chmod +x /app/worker/entrypoint.sh

ENTRYPOINT ["/app/worker/entrypoint.sh"]
