ARG NODE_IMAGE_SHA_DEBIAN_DEV
ARG PNPM_VERSION

FROM node@sha256:${NODE_IMAGE_SHA_DEBIAN_DEV}

ARG PNPM_VERSION
ENV APP_HOME=/app/enricher
ENV PNPM_VERSION=${PNPM_VERSION}
WORKDIR $APP_HOME

# 必要最小限のパッケージのみインストール（キャッシュマウントで高速化）
RUN --mount=type=cache,target=/var/cache/apt,sharing=locked \
    --mount=type=cache,target=/var/lib/apt,sharing=locked \
    apt-get update \
    && apt-get install --no-install-recommends -y wget curl ca-certificates unzip \
    && mkdir -p $APP_HOME \
    && chown -R node:node /app

# pnpm 11 の直接インストール（ダウンロード回避）
RUN npm cache clean --force && npm uninstall -g pnpm || true && npm install -g pnpm@${PNPM_VERSION} --allow-scripts=pnpm --force

# pnpm キャッシュディレクトリを先に作成してパーミッションを設定
RUN mkdir -p /home/node/.local/share/pnpm/store && chown -R node:node /home/node/.local/share/pnpm

# 1. 依存関係ファイルのみ先にコピー（レイヤーキャッシュ活用）
COPY --chown=node:node package.json ./
COPY --chown=node:node pnpm-lock.yaml ./
COPY --chown=node:node pnpm-workspace.yaml ./
COPY --chown=node:node scripts/ ./scripts/
COPY --chown=node:node ecosystem.config.cjs ./
COPY --chown=node:node src/ ./src

USER node

# 2. 依存関係インストール
RUN --mount=type=cache,id=pnpm,target=/home/node/.local/share/pnpm/store,uid=1000,gid=1000 \
    pnpm install --frozen-lockfile --store-dir=/home/node/.local/share/pnpm/store --silent

# 3. IPデータベースダウンロード用スクリプトをコピーして実行
RUN node scripts/download-ip-dbs.cjs

# Start command
CMD ["pnpm", "exec", "pm2", "start", "ecosystem.config.cjs", "--no-daemon"]
