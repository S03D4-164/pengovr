# Build stage
FROM node@sha256:8efd3ed25d83b4328df873ed9853a5bd97ffce8eb3498785e45c3e7297571f0e AS builder

ENV APP_HOME=/app/ui
WORKDIR $APP_HOME

RUN npm install -g pnpm@12.16.1

# Copy package files
COPY ui/package.json ui/pnpm-lock.yaml ui/tsconfig.json ui/vite.config.ts ui/index.html ./

RUN pnpm install --frozen-lockfile --ignore-scripts --prod --store-dir=/home/node/.local/share/pnpm/store

# Copy source code
COPY ui/src ./src

# Build
RUN pnpm run build

# Production stage
FROM nginx@sha256:0d3b80406a13a767339fbe2f41406d6c7da727ab89cf8fae399e81f780f814d1

# APIの接続先を環境変数で変更可能にする
ENV API_URL=http://api-staging:3000/api/

# Copy built files
COPY --from=builder /app/ui/dist /usr/share/nginx/html

# nginxの設定をテンプレートとしてコピー（起動時にenvsubstで環境変数が展開される）
RUN mkdir -p /etc/nginx/templates && \
    echo 'server { \
    listen 80; \
    location /api/ { \
        proxy_pass ${API_URL}; \
        proxy_http_version 1.1; \
        proxy_set_header Upgrade $http_upgrade; \
        proxy_set_header Connection "upgrade"; \
        proxy_set_header Host $host; \
        proxy_set_header X-Real-IP $remote_addr; \
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for; \
        proxy_set_header X-Forwarded-Proto $scheme; \
    } \
    location /pengovr/ { \
        alias /usr/share/nginx/html/; \
        index index.html; \
        try_files $uri $uri/ /pengovr/index.html; \
    } \
    location = / { \
        return 301 /pengovr/; \
    } \
}' > /etc/nginx/templates/default.conf.template

EXPOSE 80

CMD ["/bin/sh", "-c", "envsubst '\\$API_URL' < /etc/nginx/templates/default.conf.template > /etc/nginx/conf.d/default.conf && nginx -g 'daemon off;'"]
